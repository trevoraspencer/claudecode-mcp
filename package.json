{
  "name": "claudecode-mcp",
  "version": "2.0.0",
  "private": true,
  "description": "MCP server that runs Claude Code as an async task runner: start, track, steer, and collect coding and review tasks.",
  "license": "MIT",
  "author": "Trevor Spencer",
  "homepage": "https://github.com/trevoraspencer/claudecode-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/trevoraspencer/claudecode-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/trevoraspencer/claudecode-mcp/issues"
  },
  "keywords": [
    "agents",
    "ai",
    "anthropic",
    "claude",
    "claude-code",
    "cli",
    "mcp",
    "model-context-protocol",
    "stdio",
    "task-runner",
    "worktree"
  ],
  "type": "module",
  "bin": {
    "claudecode-mcp": "dist/cli.js"
  },
  "main": "dist/server.js",
  "files": [
    "dist",
    "examples",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": "./dist/server.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"require('fs').chmodSync('dist/cli.js', 0o755)\"",
    "start": "node dist/cli.js",
    "pretest": "npm run build",
    "test": "node --test test/*.test.mjs",
    "test:live": "CLAUDECODE_MCP_LIVE=1 node --test test/*.test.mjs",
    "format": "prettier --write 'src/**/*.ts' 'test/**/*.mjs'",
    "format:check": "prettier --check 'src/**/*.ts' 'test/**/*.mjs'",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^4.6.5"
  },
  "overrides": {
    "@hono/node-server": "^2.0.5"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "prettier": "^3.8.3",
    "typescript": "^5.5.0"
  },
  "os": [
    "darwin",
    "linux"
  ]
}
